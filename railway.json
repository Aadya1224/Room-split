{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "api": {
      "name": "roomsplit-api",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "pnpm install && pnpm --filter @roomsplit/api build"
      },
      "deploy": {
        "startCommand": "pnpm --filter @roomsplit/api start:prod",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    },
    "web": {
      "name": "roomsplit-web",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "pnpm install && pnpm --filter @roomsplit/web build"
      },
      "deploy": {
        "startCommand": "pnpm --filter @roomsplit/web preview --host --port ${PORT:-5173}"
      }
    }
  }
}
